{% set f = "common.footer" | t(locale.code) %}
<footer class="site-footer">
  <div class="container site-footer__inner">
    <section class="legal" aria-labelledby="footer-legal-title">
      <h2 id="footer-legal-title" class="visually-hidden">{{ f.legalLabel }}</h2>
      {# ЗЕТ Art. 4 provider identification. The street address is intentionally not shown (owner decision);
         it is publicly available in the Commercial Register record linked below via the UIC. #}
      <p class="legal__name"><span{% if locale.code != "bg" %} lang="bg"{% endif %}>{{ site.legalName }}</span> ({{ site.legalNameLatin }})</p>
      <dl class="legal__list">
        <div><dt class="visually-hidden">{{ f.locationLabel }}</dt><dd>{{ f.location }}</dd></div>
        <div><dt>{{ f.eik }}</dt><dd>{{ site.eik }}</dd></div>
        <div><dt>{{ f.vat }}</dt><dd>{{ site.vatId }}</dd></div>
        <div><dt class="visually-hidden">{{ f.emailLabel }}</dt><dd><a href="{{ ('footer-' + pageKey) | lower | mailto(locale.code) }}">{{ site.email }}</a></dd></div>
      </dl>
    </section>
    <nav class="footer-nav" aria-label="{{ f.siteLabel }}">
      <ul class="footer-links">
        {% for key in ["whyUs", "services", "caseTeleservice"] %}
        <li><a href="{{ key | localeUrl(locale.code) }}"{% if pageKey == key %} aria-current="page"{% endif %}>{{ ("common.nav." + key) | t(locale.code) }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <ul class="footer-links">
      <li><a href="{{ 'privacy' | localeUrl(locale.code) }}"{% if pageKey == "privacy" %} aria-current="page"{% endif %}>{{ f.privacy }}</a></li>
      <li><a href="{{ site.commercialRegisterUrl }}" rel="external noopener noreferrer">{{ f.register }}</a></li>
      <li>
        <a class="footer-links__social" href="{{ site.linkedin }}" rel="external noopener noreferrer">
          <svg class="icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
          {{ f.linkedin }}
        </a>
      </li>
    </ul>
    <p class="copyright">&copy; {{ site.foundingYear }}{% if build.year > site.foundingYear %}–{{ build.year }}{% endif %} {{ site.brand }}. {{ f.copyright }}</p>
  </div>
</footer>
