{% set homeUrl = "home" | localeUrl(locale.code) %}
{% set nav = "common.nav" | t(locale.code) %}
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="{{ homeUrl }}"{% if pageKey == "home" %} aria-current="page"{% endif %}>
      <img class="brand__logo" src="/assets/img/favicon.svg" alt="" width="32" height="32">
      <span class="brand__name">{{ site.brand }}</span>
    </a>
    <nav class="site-nav" aria-label="{{ 'common.navLabel' | t(locale.code) }}">
      <ul class="site-nav__list">
        {% for key in ["whyUs", "services", "caseTeleservice"] %}
        <li><a href="{{ key | localeUrl(locale.code) }}"{% if pageKey == key %} aria-current="page"{% endif %}>{{ nav[key] }}</a></li>
        {% endfor %}
        <li><a href="{{ homeUrl }}#engage">{{ nav.engage }}</a></li>
        <li><a href="{{ homeUrl }}#contact">{{ nav.contact }}</a></li>
      </ul>
    </nav>
    {% include "partials/lang-switch.njk" %}
  </div>
</header>
