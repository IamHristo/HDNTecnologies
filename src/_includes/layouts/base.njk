<!doctype html>
<html lang="{{ locale.hreflang }}">
<head>
  <meta charset="utf-8">
  {# Meta CSP: no scripts at all, same-origin styles/images only. frame-ancestors, report-uri and
     sandbox are ignored in <meta> by design; GitHub Pages cannot send custom headers. #}
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta name="color-scheme" content="light dark">
  <title>{{ (pageKey + ".title") | t(locale.code) }}</title>
  <meta name="description" content="{{ (pageKey + '.description') | t(locale.code) }}">
  {% set defaultLocale = locales | selectattr("isDefault") | first %}
  {% if indexable %}
  <link rel="canonical" href="{{ site.url }}{{ pageKey | localeUrl(locale.code) }}">
  {% if locales.length > 1 %}
  {% for alt in pageKey | alternates %}
  <link rel="alternate" hreflang="{{ alt.hreflang }}" href="{{ site.url }}{{ alt.url }}">
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ pageKey | localeUrl(defaultLocale.code) }}">
  {% endif %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.brand }}">
  <meta property="og:title" content="{{ (pageKey + '.title') | t(locale.code) }}">
  <meta property="og:description" content="{{ (pageKey + '.description') | t(locale.code) }}">
  <meta property="og:url" content="{{ site.url }}{{ pageKey | localeUrl(locale.code) }}">
  <meta property="og:image" content="{{ site.url }}{{ site.ogImage }}">
  <meta property="og:image:width" content="{{ site.ogImageWidth }}">
  <meta property="og:image:height" content="{{ site.ogImageHeight }}">
  <meta property="og:image:alt" content="{{ 'common.ogImageAlt' | t(locale.code) }}">
  <meta property="og:locale" content="{{ locale.ogLocale }}">
  {% for other in locales %}{% if other.code != locale.code %}
  <meta property="og:locale:alternate" content="{{ other.ogLocale }}">
  {% endif %}{% endfor %}
  <meta name="twitter:card" content="summary_large_image">
  {% else %}
  <meta name="robots" content="noindex">
  {% endif %}
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/img/favicon-48.png" type="image/png" sizes="48x48">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <meta name="theme-color" content="{{ site.themeColor }}">
  <link rel="stylesheet" href="/assets/css/site.css">
  {% if indexable %}
  {# JSON-LD is a data block, never executed, so the script-free CSP does not affect it. #}
  <script type="application/ld+json">
{{ pageKey | structuredData(locale.code) | safe }}
  </script>
  {% endif %}
</head>
<body>
  <a class="skip-link" href="#main">{{ "common.skipLink" | t(locale.code) }}</a>
  {% include "partials/header.njk" %}
  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
</body>
</html>
